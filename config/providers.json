        "lissi_pid_sdjwt": {
            "type": "api",
            "base_url": "https://ux-backend-demo.lissi.io",
            "group": "EUDI credentials",
            "credential_type": {
                "name": "Lissi demo PID as SD-JWT",
                "format": "vc+sd-jwt",
                "vct": "https://pidissuer.demo.connector.lissi.io/pid"
            },
            "issuer_metadata": "https://pidissuer.demo.connector.lissi.io/.well-known/openid-credential-issuer",
            "credential_configuration_id": "pid",
            "notes": "Lissi's own demo PID: its vct is not one of the listed credential types. It pairs only with the other lissi_pid_sdjwt row, and only in a wallet that accepts a vc+sd-jwt credential for a dc+sd-jwt request: the vct and claims match, the format identifiers do not. Minted the way www.lissi.id/demo-receive-pid does. The backend answers with a link into Lissi's own web wallet (https://wallet.lissi.io/lite?credential_offer_uri=…), so rewrite_scheme turns it into an openid-credential-offer:// link with the same query. The configuration's format is the older vc+sd-jwt identifier, while Lissi's verifier asks for dc+sd-jwt. Its authorization server lists only attest_jwt_client_auth as a token endpoint auth method while also allowing anonymous pre-authorized access; whether a wallet without an attestation is refused is unverified.",
            "credentials": {
                "credential_issuance": {
                    "type": "issuance",
                    "path": "/pid-issuance",
                    "response_field": "redirectUrl",
