                "credential_issuance": {
                    "type": "issuance",
                    "path": "/functions/v1/issue-credential",
                    "body": {
                        "credentialType": "pid-mdoc",
                        "sessionId": "{{uuid}}",
                        "ecosystem": "eudiw"
                    },
                    "response_field": "request_uri"
                }
            }
