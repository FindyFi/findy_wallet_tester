        "multipaz_pid_mdoc": {
            "type": "multipaz",
            "base_url": "https://issuer.multipaz.org",
            "group": "EUDI credentials",
            "credential_type": {
                "name": "PID as mDoc",
                "format": "mso_mdoc",
                "doctype": "eu.europa.ec.eudi.pid.1"
            },
            "issuer_metadata": "https://issuer.multipaz.org/.well-known/openid-credential-issuer/issuer",
            "credential_configuration_id": "pid_mdoc",
            "notes": "The token endpoint authenticates the client (token_endpoint_auth_methods_supported: private_key_jwt, attest_jwt_client_auth); a token request without one fails 'client_id parameter missing' / 'clientId must be authenticated'. Only a wallet that presents a client or wallet attestation Multipaz accepts gets past it. Past the token endpoint, the configuration accepts only key-attestation proofs (proof_types_supported: attestation), not jwt proofs, so a wallet without key attestation also fails at the credential request. Expect this row to fail for wallets that support neither; it is kept to show when they do.",
            "credentials": {
                "credential_issuance": {
                    "type": "issuance",
                    "configuration_id": "pid_mdoc"
                }
            }
        },
