{
    "application": {
        "package": "com.gataca.identity",
        "activity": ".MainActivity",
        "email": "your.gataca.test@example.com",
        "pin": "${GATACA_APP_PIN:-'123456'}"
    },
    "timeouts": {
        "default": 10,
        "pin_digit_delay": 0.3,
        "credential_offer": 30
    },
    "reporting": {
        "screenshot_on_failure": "${DEFAULT_SCREENSHOT_ON_FAILURE:-true}",
        "xml_on_failure": "${DEFAULT_XML_ON_FAILURE:-true}"

    },
    "onboarding": {
        "reset": "${GATACA_RESET:-false}"
    },
    "did_method": "${DID_METHODS:-jwk}",
    "cleanup": {
        "max_credentials": "${DEFAULT_MAX_CREDENTIALS:-0}"
    }
}
