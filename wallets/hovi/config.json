{
    "application": {
        "package": "droidwallet.hovi.id",
        "activity": ".MainActivity",
        "pin": "${HOVI_APP_PIN:-''}"
    },
    "timeouts": {
        "default": 10,
        "credential_offer": 30
    },
    "reporting": {
        "screenshot_on_failure": "${DEFAULT_SCREENSHOT_ON_FAILURE:-true}",
        "xml_on_failure": "${DEFAULT_XML_ON_FAILURE:-true}"
    },
    "onboarding": {
        "reset": "${DEFAULT_RESET:-false}"
    },
    "cleanup": {
        "max_credentials": "${DEFAULT_MAX_CREDENTIALS:-0}"
    }
}
