            }
        },
        "waltid_verifier": {
            "base_url": "https://verifier.waltid.pensiondemo.findy.fi",
            "credentials": {
                "pension_verification": { "type": "verification", "path": "/" }
            }
        },
        "paradym_verifier": {
            "base_url": "https://verifier.paradym.pensiondemo.findy.fi",
            "credentials": {
                "pension_verification": { "type": "verification", "path": "/" }
            }
        }
    }
}
