{
    "server": "http://localhost:4723",
    "android": {
        "platform_name": "Android",
        "device_name": "${HEIDI_DEVICE_NAME}",
        "automation_name": "UiAutomator2",
        "device_pin": "${HEIDI_DEVICE_PIN}"
    },
    "application": {
        "package": "ch.ubique.heidi.android",
        "activity": ".MainActivity",
        "pin": "${HEIDI_APP_PIN}"
    },
    "timeouts": {
        "default": 10,
        "pin_digit_delay": 0.3,
        "credential_offer": 30
    },
    "reporting": {
        "screenshot_on_failure": "${DEFAULT_SCREENSHOT_ON_FAILURE:-false}",
        "xml_on_failure": "${DEFAULT_XML_ON_FAILURE:-true}"
    },
    "onboarding": {
        "reset": "${DEFAULT_RESET:-false}"
    }
}
