{
    "server": "http://localhost:4723",
    "android": {
        "platform_name": "Android",
        "device_name": "${HEIDI_DEVICE_NAME}",
        "automation_name": "UiAutomator2",
        "device_pin": "${HEIDI_DEVICE_PIN}"
    },
    "application": {
        "package": "ch.ubique.heidi.android",
        "activity": ".MainActivity",
        "pin": "${HEIDI_APP_PIN}"
    },
    "timeouts": {
        "default": 10,
        "pin_digit_delay": 0.3,
        "credential_offer": 30
    },
    "reporting": {
        "screenshot_on_failure": false,
        "xml_on_failure": true
    },
    "onboarding": {
        "skip_if_done": true
    },
    "test_cases": {
        "authbound_issuer": {
            "type": "authbound",
            "base_url": "https://authbound.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "slug": "kael" }
            }
        },
        "authbound_verifier": {
            "type": "authbound",
            "base_url": "https://authbound.pensiondemo.findy.fi",
            "credentials": {
                "pension_verification": { "type": "verification" }
            }
        },
        "hovi_issuer": {
            "base_url": "https://issuer.hovi.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "path": "pensioncredential.json" }
            }
        },
        "procivis_issuer": {
            "base_url": "https://issuer.procivis.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "path": "pensioncredential.json" }
            }
        },
        "waltid_issuer": {
            "base_url": "https://issuer.waltid.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "path": "pensioncredential.json" }
            }
        },
        "paradym_issuer": {
            "base_url": "https://issuer.paradym.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "path": "pensioncredential.json" }
            }
        },
        "sphereon_issuer": {
            "base_url": "https://issuer.sphereon.pensiondemo.findy.fi",
            "credentials": {
                "credential_issuance": { "type": "issuance", "path": "pensioncredential.json" }
            }
        },
        "hovi_verifier": {
            "base_url": "https://verifier.hovi.pensiondemo.findy.fi",
            "credentials": {
                "pension_verification": { "type": "verification", "path": "/" }
            }
