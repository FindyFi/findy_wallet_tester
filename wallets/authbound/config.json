{
    "application": {
        "package": "io.authbound.wallet",
        "activity": "eu.europa.ec.assemblylogic.ui.MainActivity",
        "pin": "${AUTHBOUND_APP_PIN:-'123456'}"
    },
    "timeouts": {
        "default": 10,
        "pin_digit_delay": 0.3,
        "credential_offer": 30
    },
    "reporting": {
        "screenshot_on_failure": "${DEFAULT_SCREENSHOT_ON_FAILURE:-true}",
        "xml_on_failure": "${DEFAULT_XML_ON_FAILURE:-true}"
    },
    "onboarding": {
        "reset": "${AUTHBOUND_RESET:-false}"
    },
    "requires_fingerprint": true,
    "cleanup": {
        "max_credentials": "${DEFAULT_MAX_CREDENTIALS:-0}"
    }
}
