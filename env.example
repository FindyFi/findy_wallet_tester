# Machine-specific settings. Copy to .env and fill in — .env is gitignored, so real
# device serials and PINs never enter the repository. Shell exports take precedence.
#
# NOTE: keep comments on their own lines. Values are read as everything after the first
# "=", so a trailing "# comment" would become part of the value.
#
# Naming convention:
#   DEFAULT_<SETTING>   a shared default, applied to every wallet
#   <WALLET>_<SETTING>  overrides the shared default for that wallet only
# Anything a wallet must set for itself (its PIN, its device) has no shared form.
# Nearly every setting below is optional: leave it unset and the value committed in
# config/device.json or wallets/<wallet>/config.json is used. The exceptions are the settings a
# config writes as a bare ${VAR}, which has no default to fall back on: DEVICE_NAME and
# DEVICE_PIN below, plus HEIDI_APP_PIN and SPHEREON_EMAIL. Each is marked REQUIRED where it
# appears, and an unset one stops the run rather than being substituted with a blank.

# ---------------------------------------------------------------------------
# Device
# ---------------------------------------------------------------------------

# The phone under test: its adb serial (see `adb devices`) and screen-lock PIN.
DEVICE_NAME=
DEVICE_PIN=

# Any wallet can be sent to a different device by prefixing its name — the same
# convention as every other setting. Set one and that wallet uses it; leave it unset
# and the wallet falls back to DEVICE_NAME above. No wallet config names a device.
#   TOPPAN_DEVICE_NAME=emulator-5554
#   TOPPAN_DEVICE_PIN=1234
# Leave a PIN blank for a device with no lock screen.
#
# heidi is the standing case: it is tested on the emulator, not the phone. Nothing
# enforces that, so if you clear these heidi runs on DEVICE_NAME like everything else.
# Each run records the device it actually used in reports/<run>/<wallet>/app_info.json.
HEIDI_DEVICE_NAME=
HEIDI_DEVICE_PIN=
# heidi's in-app passcode (not the device lock). REQUIRED: wallets/heidi/config.json writes it
# as ${HEIDI_APP_PIN} with no default, so heidi cannot run until this is set.
HEIDI_APP_PIN=

# sphereon is the other wallet on the emulator rather than the phone, for the same reason and
# with the same caveat: nothing enforces it, so clearing these sends sphereon to DEVICE_NAME.
SPHEREON_DEVICE_NAME=
SPHEREON_DEVICE_PIN=

# ---------------------------------------------------------------------------
# Shared defaults
# ---------------------------------------------------------------------------

# Wipe each wallet's data and onboard again once per session, so a run starts from an
# empty wallet. Off by default because it is slower and destroys anything the wallet
# holds. A verification that passes on a credential left over from an earlier run is
# not evidence about today's issuer, so turn this on for results you intend to publish.
#
# authbound and gataca deliberately ignore this: both need manual email/server
# registration, so a wipe leaves them unusable. Set AUTHBOUND_RESET / GATACA_RESET
# by hand if you really mean it, and be ready to re-register them.
DEFAULT_RESET=

# How many credentials end-of-run cleanup leaves behind. 0 empties the wallet.
# Only wallets with a cleanup flow read this (authbound, gataca, hovi).
DEFAULT_MAX_CREDENTIALS=

# Check the Play Store for a newer build once per wallet session. Turn off for quick
# smoke runs: it costs a Play Store round trip per wallet and tests nothing about interop.
DEFAULT_UPDATES=

# Capture a screenshot and an XML page dump when a test fails.
DEFAULT_SCREENSHOT_ON_FAILURE=
DEFAULT_XML_ON_FAILURE=

# ---------------------------------------------------------------------------
# Issuers and verifiers
# ---------------------------------------------------------------------------

# Every issuer and verifier is defined once in config/providers.json, and every wallet
# is tested against the same set — that set is the interop matrix, not a property of any
# one wallet. These lists choose which of them a run exercises.
#
# Values are the bare names used in that file, with no _issuer / _verifier suffix:
#   issuers    authbound, hovi, procivis, waltid, paradym, sphereon
#   verifiers  authbound, hovi, procivis, waltid, paradym
#
# Leave blank to run every provider, which is what published runs do. Write "none" to run
# none of them. A name that is not in the registry stops the run rather than being ignored,
# because a typo would otherwise publish a matrix with a row quietly missing.
#
# The list selects, it does not order: results always follow the registry, so two runs stay
# comparable.
DEFAULT_ISSUERS=
DEFAULT_VERIFIERS=

# Per-wallet, the same as any other setting — swap DEFAULT_ for the wallet's name:
#   HOVI_ISSUERS=procivis,hovi
#   HEIDI_VERIFIERS=none

# Everything else about a provider — above all where it is deployed — is configured in
# config/providers.json and nowhere else. To test against your own instance, change that
# entry's base_url. These lists only choose which of the configured providers run.

# Only needed for a test case of type "itb" (none are configured by default). Unlike the
# settings above these are required once such a case is selected: the run stops rather than
# starting and failing to authenticate.
ITB_USERNAME=
ITB_PASSWORD=

# ---------------------------------------------------------------------------
# Per-wallet overrides
# ---------------------------------------------------------------------------

# Any shared default above can be overridden for one wallet by swapping the DEFAULT_
# prefix for the wallet's name, e.g.
#   HOVI_RESET=false
#   TOPPAN_MAX_CREDENTIALS=2
#   HEIDI_SCREENSHOT_ON_FAILURE=true
#   UNIME_ISSUERS=hovi,waltid

# gataca runs its whole issuer/verifier matrix once per DID method, so this multiplies the
# number of cases. One method keeps the run short; several compare them side by side, and the
# report shows pass/fail per (method x provider). Supported: jwk, gatc, ebsi.
#   GATACA_DID_METHODS=jwk,ebsi
# Blank uses the default committed in wallets/gataca/config.json. A method the wallet does not
# support stops the run rather than being dropped from the matrix in silence.
GATACA_DID_METHODS=

# authbound and gataca have no shared reset: both need manual email/server registration,
# so DEFAULT_RESET deliberately does not reach them. Set these only if you are ready to
# re-register the wallet by hand afterwards.
AUTHBOUND_RESET=
GATACA_RESET=

# sphereon asks for a name and an email address during onboarding — the only wallet in the
# suite that needs more than a PIN to get through its first run.
#
# SPHEREON_EMAIL is REQUIRED. wallets/sphereon/config.json writes it as ${SPHEREON_EMAIL} with
# no committed default, so with it unset load_config raises and every sphereon test errors in
# setup. Collection still succeeds, which is why this is easy to miss: the failure appears only
# once a test actually runs.
#
# Both values are typed into the wallet and stay there. Onboarding self-issues a "Sphereon
# Wallet Identity" credential from them, so they become part of the wallet's own data and show
# up in its credential list — use an address you are willing to see on the device, not a
# personal one. It also means a wiped sphereon holds 1 credential rather than 0.
SPHEREON_EMAIL=
# Blank uses the default committed in wallets/sphereon/config.json ('Findy Test').
SPHEREON_HOLDER_NAME=

# Wanted for the same reason TOPPAN_RESET is: sphereon has no per-credential delete to fall
# back on (its actions menu offers only "Raw credential"), so wipe-and-onboard is its only
# clean slate. Note that even a wipe leaves the self-issued identity card above, so "clean"
# means 1 credential here — see wallets/README.md under Clean-slate strategy.
SPHEREON_RESET=

# Provider selection for sphereon alone, with the same syntax as DEFAULT_ISSUERS above. Blank
# follows the shared lists, so set these only when this wallet's matrix should differ — e.g. to
# keep waltid in for sphereon when the shared default has dropped it.
SPHEREON_ISSUERS=
SPHEREON_VERIFIERS=

# App passcodes. Each wallet's committed default is used when these are unset; set one
# only if your install differs. Values are always read as text, so a leading zero is safe.
AUTHBOUND_APP_PIN=
GATACA_APP_PIN=
HOVI_APP_PIN=
PARADYM_APP_PIN=
PROCIVIS_APP_PIN=
# sphereon's PIN is set during onboarding, so this is the PIN the wallet gets, not one it
# already has. It must be 6 digits, and the wallet refuses six of the same digit or a
# consecutive run (1-2-3-4-5-6, 6-5-4-3-2-1).
SPHEREON_APP_PIN=
TOPPAN_APP_PIN=
UNIME_APP_PIN=
